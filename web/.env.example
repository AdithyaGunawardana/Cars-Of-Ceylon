DATABASE_URL="postgresql://postgres:postgres@db:5432/cars_of_ceylon?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

UPLOAD_S3_ENDPOINT="http://localhost:9000"
UPLOAD_S3_REGION="us-east-1"
UPLOAD_S3_BUCKET="cars-of-ceylon"
UPLOAD_S3_ACCESS_KEY_ID=""
UPLOAD_S3_SECRET_ACCESS_KEY=""
UPLOAD_S3_PUBLIC_BASE_URL=""

# Email (password reset + email verification). Without SMTP_URL, emails are printed to the server log (dev only).
SMTP_URL=""
MAIL_FROM="Cars of Ceylon <no-reply@example.com>"

# Origins allowed to PUT photos to the bucket (used by `npm run storage:cors` on S3/R2). Defaults to AUTH_URL.
UPLOAD_CORS_ORIGINS=""

SEED_ADMIN_EMAIL="admin@carsofceylon.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
